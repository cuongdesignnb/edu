# EduManage frontend demo — chỉ cấu hình demo/feature flag, KHÔNG chứa secret.
# demo: bật /demo và /preview/* (UI lab nội bộ). Giá trị khác sẽ ẩn UI lab.
NEXT_PUBLIC_APP_MODE=demo
# Module kết quả học tập (EX01–EX03) — tắt mặc định, chỉ bật khi chủ dự án duyệt.
NEXT_PUBLIC_ENABLE_ACADEMIC_RESULTS_PREVIEW=false
