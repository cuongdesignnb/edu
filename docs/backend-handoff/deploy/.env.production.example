# Các giá trị cần chốt; không chứa mật khẩu.
COMPOSE_PROJECT_NAME=edumanage_prod
APP_ENV=production
APP_PORT=18763
APP_URL=https://REPLACE_WITH_DOMAIN
POSTGRES_DB=edumanage_prod
SECRET_DIR=./.secrets/production
POSTGRES_IMAGE=REPLACE_POSTGRES17_IMAGE_AT_SHA256
NGINX_IMAGE=REPLACE_NGINX_IMAGE_AT_SHA256
API_IMAGE_REF=REPLACE_REGISTRY_API_AT_SHA256
WEB_IMAGE_REF=REPLACE_REGISTRY_WEB_AT_SHA256
IMAGE_TAG=REPLACE_COMMIT_SHA
COOKIE_SECURE=true
MAIL_MODE=smtp
MAIL_FROM=REPLACE_WITH_VERIFIED_SENDER
SMTP_HOST=REPLACE_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_SMTP_USER
