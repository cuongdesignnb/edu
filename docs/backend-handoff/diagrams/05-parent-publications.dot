graph [rankdir=LR, bgcolor="#ffffff", pad="0.4", nodesep="0.5", ranksep="1.1", splines=polyline, fontname="DejaVu Sans", label="Tra cứu riêng và bản công bố", labelloc=t, fontsize=24];
