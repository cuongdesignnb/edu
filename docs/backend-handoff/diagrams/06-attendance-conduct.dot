digraph G {
graph [rankdir=LR, bgcolor="#ffffff", pad="0.4", nodesep="0.5", ranksep="1.1", splines=polyline, fontname="DejaVu Sans", label="Điểm danh, nội quy và thi đua", labelloc=t, fontsize=24];
