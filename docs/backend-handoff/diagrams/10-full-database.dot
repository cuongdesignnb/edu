digraph G {
graph [rankdir=LR, bgcolor="#ffffff", pad="0.4", nodesep="0.5", ranksep="1.1", splines=polyline, fontname="DejaVu Sans", label="EduManage — Sơ đồ vật lý PostgreSQL (75 bảng; phóng to để đọc)", labelloc=t, fontsize=24];
