digraph G {
graph [rankdir=LR, bgcolor="#ffffff", pad="0.4", nodesep="0.5", ranksep="1.1", splines=polyline, fontname="DejaVu Sans", label="Học sinh, người giám hộ và lịch sử", labelloc=t, fontsize=24];
node [shape=plain,fontname="DejaVu Sans",fontsize=10];
edge [color="#8191a8",arrowsize=0.65,fontname="DejaVu Sans",fontsize=8];
"identity.users" [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#d7dfe9" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#98a4b3" ALIGN="LEFT"><FONT COLOR="white"><B>identity.users</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">Danh tính nhân sự [ngoài nhóm]</TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK id</TD><TD ALIGN="LEFT"><FONT COLOR="#66758a">uuid *</FONT></TD></TR></TABLE>>];
