digraph G {
graph [rankdir=LR, bgcolor="#ffffff", pad="0.4", nodesep="0.5", ranksep="1.1", splines=polyline, fontname="DejaVu Sans", label="Nhà trường, năm học và phân công", labelloc=t, fontsize=24];
node [shape=plain,fontname="DejaVu Sans",fontsize=10];
edge [color="#8191a8",arrowsize=0.65,fontname="DejaVu Sans",fontsize=8];
