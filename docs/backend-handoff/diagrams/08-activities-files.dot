graph [rankdir=LR, bgcolor="#ffffff", pad="0.4", nodesep="0.5", ranksep="1.1", splines=polyline, fontname="DejaVu Sans", label="Hoạt động, minh chứng, tệp và thông báo", labelloc=t, fontsize=24];
