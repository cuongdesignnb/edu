{
  "name": "edumanage-backend",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests scripts",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "migrate": "node dist/cli.js migrate",
    "test": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:contract": "node --test tests/contract/*.test.mjs",
    "contract:generate": "node scripts/generate-contract.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.2",
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-fastify": "12.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "argon2": "0.45.1",
    "csv-parse": "7.0.3",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "nodemailer": "10.0.12",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.5",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@types/node": "24.10.13",
    "@types/nodemailer": "7.0.11",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "@types/yauzl": "2.10.3",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "yaml": "2.9.1"
  }
}
