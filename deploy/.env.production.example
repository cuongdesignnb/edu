# Copy to root .env.production; no passwords/tokens belong here.
COMPOSE_PROJECT_NAME=edumanage_production
APP_ENV=production
APP_PORT=18763
APP_URL=https://REPLACE_DOMAIN
POSTGRES_DB=edumanage_production
SECRET_DIR=./.secrets/production
API_IMAGE_REF=ghcr.io/cuongdesignnb/edu-api:REPLACE_RELEASE
WEB_IMAGE_REF=ghcr.io/cuongdesignnb/edu-web:REPLACE_RELEASE
# release.sh sets the verified OCI source SHA and locks API/Web to digests.
SOURCE_SHA=REPLACE_SOURCE_SHA
POSTGRES_IMAGE=postgres:17-bookworm@sha256:639ab7ceb90e13123085b741fb31ef493fba25463002f6da665352e7b534b652
NGINX_IMAGE=nginx:stable-alpine@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94
COOKIE_SECURE=true
# SMTP is optional and configured only in /platform/settings; legacy blank SMTP
# variables are accepted but never used for sending. mail_key remains required.
MAIL_MODE=database
